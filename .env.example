# ==============================================================================
# PhishShield Environment Variables Template
# Copy to .env for local configuration or container deployment
# ==============================================================================

# Core Application Settings
PROJECT_NAME=PhishShield
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=change-me-in-production-use-a-strong-secret-key-32chars
ADMIN_INITIAL_PASSWORD=

# Security & Authentication Tuning
PBKDF2_ITERATIONS=600000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Database Configuration
DATABASE_URL=sqlite:///./phishshield.db

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80

# Performance & OCR Concurrency Hardening
MAX_CONCURRENT_OCR=1
MAX_OCR_QUEUE_DEPTH=10
OCR_TIMEOUT_SECONDS=120

# Model Cache Directories (Optional override)
EASYOCR_MODULE_PATH=
TORCH_HOME=

# Optional AI explanation key (system runs fully offline if omitted)
GEMINI_API_KEY=
