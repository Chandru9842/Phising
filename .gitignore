# ==============================================================================
# PhishShield Production Root .gitignore
# Excludes environments, build outputs, transient data, secrets and test caches.
# Preserves pre-trained ML models, application source code, and configuration templates.
# ==============================================================================

# Python Virtual Environments
venv/
env/
ENV/
.venv/
*/venv/
backend/venv/

# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
.tox/

# Node.js and Frontend Build Artifacts
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
dist/

# Environment Configuration & Local Secrets (Do NOT commit real credentials)
.env
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Local SQLite Databases & Transaction Logs
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/phishshield.db*
test_*.db

# OCR & Neural Model Download Caches (Do not commit downloaded weights)
backend/models/easyocr/
backend/models/torch/
~/.EasyOCR/
.EasyOCR/

# Explicitly PRESERVE Pre-Trained Project ML Classifier Models
!backend/app/ml/saved_models/url_rf_model.joblib
!backend/app/ml/sms/saved_models/sms_tfidf_lr_model.joblib

# OS Metadata & IDE Configuration
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Temporary Files, Logs & Scratch Artifacts
*.log
*.tmp
tmp/
temp/
scratch/
.agents/
